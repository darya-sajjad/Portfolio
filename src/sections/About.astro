---
---

<section id="about" class="w-full max-w-7xl mx-auto py-6 sm:py-10">

  <div class="text-center mb-8 sm:mb-10">
    <h2 class="font-extrabold text-black tracking-tight inline-block">
      <span class="bg-matcha border-2 sm:border-3 border-black px-10 py-2 sm:px-10 sm:py-2.5 rounded-4xl shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] inline-block -rotate-1 text-3xl sm:text-3xl">
        About Me
      </span>
    </h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-5 gap-3.5 sm:gap-4 relative">

    <div class="md:col-span-3 bg-white border-2 border-black rounded-2xl p-4 sm:p-5 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] flex flex-col justify-between relative">
      <div>
        <div class="mb-2.5 flex justify-between items-center">
          <span class="bg-pink border-2 border-black px-3 py-0.5 rounded-full text-[11px] font-extrabold uppercase tracking-wider shadow-[1px_1px_0px_0px_rgba(0,0,0,1)] inline-block">
            HELLO!
          </span>
          <span class="text-pink">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z"/>
            </svg>
          </span>
        </div>
        <p class="text-xs sm:text-sm text-black/85 font-medium leading-relaxed">
          I am Darya Sajjad, also known as Daisy. I am an app developer driven by the challenge of building complete digital products from scratch. My background in graphic design taught me how to create user interfaces, while my passion for engineering drove me to master full-stack data flow. I believe I still have a lot to learn, and I am always looking for opportunities to grow and become more proficient in my skills.
        </p>
      </div>
    </div>

    <div class="md:col-span-2 bg-white border-2 border-black rounded-2xl p-4 sm:p-5 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] flex flex-col justify-between relative">
      <div>
        <div class="mb-2.5 flex justify-between items-center">
          <span class="bg-lavender border-2 border-black px-3 py-0.5 rounded-full text-[11px] font-extrabold uppercase tracking-wider shadow-[1px_1px_0px_0px_rgba(0,0,0,1)] inline-block">
            Certificates
          </span>
          <span class="text-lavender">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z"/>
            </svg>
          </span>
        </div>

        <ul class="space-y-2 text-xs">
          <li class="border-b border-black/10 pb-1.5">
            <p class="font-bold text-black leading-snug">Foundations of UX Design</p>
            <p class="text-[10px] text-black/60 font-medium">Google via Coursera</p>
          </li>
          <li class="border-b border-black/10 pb-1.5">
            <p class="font-bold text-black leading-snug">Business Analysis & Process Management</p>
            <p class="text-[10px] text-black/60 font-medium">Coursera</p>
          </li>
          <li>
            <p class="font-bold text-black leading-snug">Graphic Design Internship</p>
            <p class="text-[10px] text-black/60 font-medium">ITClub</p>
          </li>
        </ul>
      </div>
    </div>

    <div class="md:col-span-2 flex flex-col gap-3.5 sm:gap-4">
      <div class="bg-white border-2 border-black rounded-2xl p-4 sm:p-5 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] flex-1">
        <div class="mb-2">
          <span class="bg-butter border-2 border-black px-3 py-0.5 rounded-full text-[11px] font-extrabold uppercase tracking-wider shadow-[1px_1px_0px_0px_rgba(0,0,0,1)] inline-block">
            Education
          </span>
        </div>
        <h3 class="text-xs sm:text-sm font-extrabold text-black">
          B.E. Software Engineering
        </h3>
        <p class="text-[11px] text-black/70 font-semibold mt-0.5">
          Mehran University of Engneering & Technology
        </p>
        <p class="text-[10px] font-bold text-black/50 mt-1">
          2022 &ndash; 2026 (Estimated)
        </p>

        <div class="mt-3 pt-2 border-t border-dashed border-black/20 flex items-center gap-2">
          <span class="text-[10px] font-extrabold text-black/50 uppercase">Languages:</span>
          <span class="text-[11px] font-bold text-black">English &middot; Urdu</span>
        </div>
      </div>

      <div class="bg-white border-2 border-black rounded-2xl p-4 sm:p-5 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] flex-1">
        <div class="mb-2">
          <span class="bg-matcha border-2 border-black px-3 py-0.5 rounded-full text-[11px] font-extrabold uppercase tracking-wider shadow-[1px_1px_0px_0px_rgba(0,0,0,1)] inline-block">
            Design & Tools
          </span>
        </div>
        <div class="flex flex-wrap gap-1.5 mt-2">
          {['GitHub', 'Figma', 'VS Code', 'Vercel'].map(tool => (
            <span class="bg-cream border border-black px-2 py-0.5 rounded-lg text-[11px] font-bold shadow-[1px_1px_0px_0px_rgba(0,0,0,1)]">
              {tool}
            </span>
          ))}
        </div>
      </div>
    </div>

    <div class="md:col-span-3 bg-white border-2 border-black rounded-2xl p-4 sm:p-5 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] flex flex-col justify-between">
      <div>
        <div class="mb-2.5">
          <span class="bg-sky border-2 border-black px-3 py-0.5 rounded-full text-[11px] font-extrabold uppercase tracking-wider shadow-[1px_1px_0px_0px_rgba(0,0,0,1)] inline-block">
            Skills & Tech
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <h4 class="text-[10px] font-extrabold text-black/50 uppercase tracking-wide mb-1">Languages & Frameworks</h4>
            <div class="flex flex-wrap gap-1.5">
              {['TypeScript', 'JavaScript', 'React', 'React Native', 'Astro'].map(skill => (
                <span class="bg-cream border border-black px-2 py-0.5 rounded-lg text-[11px] font-bold shadow-[1px_1px_0px_0px_rgba(0,0,0,1)]">
                  {skill}
                </span>
              ))}
            </div>
          </div>

          <div>
            <h4 class="text-[10px] font-extrabold text-black/50 uppercase tracking-wide mb-1">UI Styling</h4>
            <div class="flex flex-wrap gap-1.5">
              {['HTML5', 'CSS3', 'Tailwind CSS'].map(skill => (
                <span class="bg-cream border border-black px-2 py-0.5 rounded-lg text-[11px] font-bold shadow-[1px_1px_0px_0px_rgba(0,0,0,1)]">
                  {skill}
                </span>
              ))}
            </div>
          </div>

          <div>
            <h4 class="text-[10px] font-extrabold text-black/50 uppercase tracking-wide mb-1">Databases & BaaS</h4>
            <div class="flex flex-wrap gap-1.5">
              {['SQLite', 'MongoDB', 'Supabase'].map(skill => (
                <span class="bg-cream border border-black px-2 py-0.5 rounded-lg text-[11px] font-bold shadow-[1px_1px_0px_0px_rgba(0,0,0,1)]">
                  {skill}
                </span>
              ))}
            </div>
          </div>

          <div>
            <h4 class="text-[10px] font-extrabold text-black/50 uppercase tracking-wide mb-1">Core Engineering</h4>
            <div class="flex flex-wrap gap-1.5">
              {['REST API Integration', 'Version Control (Git)'].map(skill => (
                <span class="bg-cream border border-black px-2 py-0.5 rounded-lg text-[11px] font-bold shadow-[1px_1px_0px_0px_rgba(0,0,0,1)]">
                  {skill}
                </span>
              ))}
            </div>
          </div>

          <div>
            <h4 class="text-[10px] font-extrabold text-black/50 uppercase tracking-wide mb-1">Personal</h4>
            <div class="flex flex-wrap gap-1.5">
              {['Time management', 'Adaptability', 'Organization', 'Self-motivation', 'Flexibility'].map(skill => (
                <span class="bg-cream border border-black px-2 py-0.5 rounded-lg text-[11px] font-bold shadow-[1px_1px_0px_0px_rgba(0,0,0,1)]">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>