---
const projects = [
  {
    id: "melomu",
    title: "Melomu",
    subtitle: "Offline Music App",
    description: "Melomu is an offline music player built with Expo and React Native. Import your own audio files, organize library, browse by song/album/artist, & build playlists — all backed by a local SQLite database, with synced lyrics cached for offline use.",
    tags: ["Expo", "React Native", "TypeScript", "SQLite", "Offline-first"],
    github: "https://github.com/darya-sajjad/Melomu",
    thumbnail: "/projects/melomu-thumb.jpg",
    demoTitle: "Melomu App Demo",
    demoDescription: "Full local music library playback, offline synced lyrics rendering, and custom SQLite database management in action.",
    demoMediaUrl: "/projects/melomu-demo.mp4"
  },
  {
    id: "portfolio",
    title: "Developer Branding Platform",
    subtitle: "Personal portfolio, a mini project",
    description: "Challenging myself to step outside my native mobile comfort zone, I developed a personal branding platform to showcase my engineering ecosystem and transition from native mobile development into modern web architecture.",
    tags: ["Astro", "TypeScript", "Tailwind CSS", "Web development"],
    github: "https://github.com/darya-sajjad/Portfolio",
    thumbnail: "/projects/portfolio-thumb.jpg",
    demoTitle: "Portfolio Site Preview",
    demoDescription: "Interactive retro bento grid layouts, responsive CSS styling, and custom Astro static build performance.",
    demoMediaUrl: "/projects/portfolio-demo.png"
  },
  {
    id: "spotify-controller",
    title: "Spotify Controller",
    subtitle: "Mini electron desktop widget",
    description: "A cute, tiny frameless Electron widget that displays and controls your currently playing Spotify track — cover art, scrolling title, seekable progress bar, and playback controls, right on your desktop.",
    tags: ["Electron", "JavaScript", "CSS", "OAuth2"],
    github: "https://github.com/darya-sajjad",
    thumbnail: "/projects/spotify-thumb.jpg",
    demoTitle: "Spotify Desktop Widget Demo",
    demoDescription: "Frameless Electron window floating on desktop with real-time Spotify API OAuth token polling and playback control.",
    demoMediaUrl: "/projects/spotify-demo.png"
  }
];
---

<section id="projects" class="w-full max-w-7xl mx-auto py-6 sm:py-10">
  
  {/* Header Row: "My Projects" Pill + Pagination Controls */}
  <div class="flex items-center justify-between mb-5 sm:mb-6">
    
    {/* Static Title Pill Button */}
    <div class="bg-lavender border-2 border-black px-4 py-1.5 sm:px-5 sm:py-2 rounded-2xl shadow-[2.5px_2.5px_0px_0px_rgba(0,0,0,1)] -rotate-1">
      <h2 class="text-sm sm:text-base font-extrabold text-black uppercase tracking-wide">
        My Projects
      </h2>
    </div>

    {/* Navigation Prev / Next Buttons */}
    <div class="flex items-center gap-2">
      <button 
        id="prev-grid-btn"
        aria-label="Previous Projects Grid"
        class="bg-white border-2 border-black w-8 h-8 sm:w-10 sm:h-10 rounded-xl flex items-center justify-center font-extrabold text-base sm:text-lg shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:bg-pink active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all disabled:opacity-30 disabled:cursor-not-allowed cursor-pointer"
      >
        &lt;
      </button>
      <button 
        id="next-grid-btn"
        aria-label="Next Projects Grid"
        class="bg-white border-2 border-black w-8 h-8 sm:w-10 sm:h-10 rounded-xl flex items-center justify-center font-extrabold text-base sm:text-lg shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:bg-pink active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all disabled:opacity-30 disabled:cursor-not-allowed cursor-pointer"
      >
        &gt;
      </button>
    </div>

  </div>

  {/* 2x2 Desktop / 1x2 Mobile Grid Container */}
  <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-5 min-h-[400px]">
    {projects.map((project) => (
      <div 
        class="project-card bg-white border-2 border-black rounded-2xl p-4 sm:p-5 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] flex flex-col justify-between hidden"
        data-id={project.id}
      >
        {/* Top Content */}
        <div>
          {/* Compact Colored Frame Thumbnail Container */}
          <div class="bg-pink border-2 border-black rounded-xl p-1.5 mb-3 shadow-[1.5px_1.5px_0px_0px_rgba(0,0,0,1)]">
            <div class="h-32 sm:h-40 bg-cream border border-black rounded-lg overflow-hidden flex items-center justify-center relative">
              <img 
                src={project.thumbnail} 
                alt={project.title}
                class="w-full h-full object-cover"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
              />
              {/* Fallback image placeholder */}
              <div class="w-full h-full flex flex-col items-center justify-center bg-gradient-to-br from-butter/40 to-pink/40 p-3 text-center hidden">
                <span class="text-xl mb-1">🖼️</span>
                <span class="text-[10px] font-bold text-black/60 uppercase">{project.title}</span>
              </div>
            </div>
          </div>

          {/* Title & Subtitle */}
          <div class="mb-1.5">
            <h3 class="text-base sm:text-lg font-black text-black tracking-tight leading-snug">
              {project.title}
            </h3>
            <p class="text-[11px] sm:text-xs font-extrabold text-black/60">
              {project.subtitle}
            </p>
          </div>

          {/* Description */}
          <p class="text-xs text-black/80 font-medium leading-relaxed mb-3">
            {project.description}
          </p>

          {/* Tag Badges */}
          <div class="flex flex-wrap gap-1.5 mb-4">
            {project.tags.map(tag => (
              <span class="bg-cream border border-black px-2 py-0.5 rounded-md text-[10px] sm:text-[11px] font-bold shadow-[1px_1px_0px_0px_rgba(0,0,0,1)]">
                {tag}
              </span>
            ))}
          </div>
        </div>

        {/* Bottom Actions */}
        <div class="flex items-center gap-2 pt-3 border-t border-dashed border-black/20">
          <a 
            href={project.github}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 text-center bg-cream border-2 border-black py-1.5 rounded-xl text-xs font-extrabold text-black shadow-[1.5px_1.5px_0px_0px_rgba(0,0,0,1)] hover:bg-butter active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all"
          >
            GitHub Repo
          </a>

          <button
            type="button"
            class="open-demo-btn flex-1 text-center bg-sky border-2 border-black py-1.5 rounded-xl text-xs font-extrabold text-black shadow-[1.5px_1.5px_0px_0px_rgba(0,0,0,1)] hover:bg-matcha active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all cursor-pointer"
            data-title={project.demoTitle}
            data-description={project.demoDescription}
            data-media={project.demoMediaUrl}
          >
            View Demo &rarr;
          </button>
        </div>

      </div>
    ))}
  </div>

  {/* Dynamic Page Dots */}
  <div id="grid-dots-container" class="flex justify-center items-center gap-2 mt-6"></div>

</section>

{/* --- DEMO POPUP MODAL --- */}
<div 
  id="demo-modal" 
  class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4 hidden transition-opacity"
>
  <div class="bg-white border-2 sm:border-3 border-black rounded-3xl p-4 sm:p-6 max-w-xl w-full shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] relative">
    
    <div class="flex items-center justify-between mb-3 border-b-2 border-black pb-2.5">
      <div>
        <span class="bg-pink border border-black px-2 py-0.5 rounded-full text-[9px] font-black uppercase tracking-wider mb-0.5 inline-block">
          Preview
        </span>
        <h3 id="modal-title" class="text-base sm:text-xl font-black text-black">
          Project Demo
        </h3>
      </div>
      
      <button 
        id="close-modal-btn"
        class="bg-cream border-2 border-black w-7 h-7 rounded-lg font-black text-sm flex items-center justify-center hover:bg-pink shadow-[1.5px_1.5px_0px_0px_rgba(0,0,0,1)] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all cursor-pointer"
      >
        &times;
      </button>
    </div>

    <div class="bg-cream border-2 border-black rounded-xl overflow-hidden mb-3 aspect-video flex items-center justify-center relative">
      <div id="modal-media-content" class="w-full h-full flex flex-col items-center justify-center p-4 text-center">
        <span class="text-3xl mb-1">📹</span>
        <p class="text-xs font-extrabold text-black">Visual Preview Space</p>
        <p class="text-[11px] text-black/60 mt-0.5">Place demo assets in <code class="bg-black/10 px-1 rounded">public/projects/</code> to display live previews here!</p>
      </div>
    </div>

  </div>
</div>

{/* Client Logic: Responsive Pagination & Modal */}
<script>
  document.addEventListener('DOMContentLoaded', () => {
    let currentPage = 0;
    const cards = document.querySelectorAll<HTMLElement>('.project-card');
    const prevBtn = document.getElementById('prev-grid-btn') as HTMLButtonElement;
    const nextBtn = document.getElementById('next-grid-btn') as HTMLButtonElement;
    const dotsContainer = document.getElementById('grid-dots-container') as HTMLElement;

    function getItemsPerPage() {
      return window.innerWidth < 768 ? 2 : 4;
    }

    function updatePagination() {
      const itemsPerPage = getItemsPerPage();
      const totalPages = Math.ceil(cards.length / itemsPerPage);

      if (currentPage >= totalPages) {
        currentPage = Math.max(0, totalPages - 1);
      }

      const startIndex = currentPage * itemsPerPage;
      const endIndex = startIndex + itemsPerPage;

      cards.forEach((card, index) => {
        if (index >= startIndex && index < endIndex) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });

      // Update dots indicator
      if (dotsContainer) {
        dotsContainer.innerHTML = '';
        if (totalPages > 1) {
          for (let i = 0; i < totalPages; i++) {
            const dot = document.createElement('button');
            dot.className = `w-2.5 h-2.5 rounded-full border-2 border-black transition-all cursor-pointer ${
              i === currentPage ? 'bg-black w-5' : 'bg-white'
            }`;
            dot.setAttribute('aria-label', `Page ${i + 1}`);
            dot.addEventListener('click', () => {
              currentPage = i;
              updatePagination();
            });
            dotsContainer.appendChild(dot);
          }
        }
      }

      if (prevBtn) prevBtn.disabled = currentPage === 0 || totalPages <= 1;
      if (nextBtn) nextBtn.disabled = currentPage >= totalPages - 1 || totalPages <= 1;
    }

    if (prevBtn) prevBtn.addEventListener('click', () => {
      if (currentPage > 0) {
        currentPage--;
        updatePagination();
      }
    });

    if (nextBtn) nextBtn.addEventListener('click', () => {
      currentPage++;
      updatePagination();
    });

    window.addEventListener('resize', updatePagination);
    updatePagination();

    // Modal Logic
    const modal = document.getElementById('demo-modal');
    const modalTitle = document.getElementById('modal-title');
    const modalDescription = document.getElementById('modal-description');
    const closeModalBtn = document.getElementById('close-modal-btn');
    const modalDoneBtn = document.getElementById('modal-done-btn');
    const openDemoBtns = document.querySelectorAll('.open-demo-btn');

    openDemoBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const title = target.getAttribute('data-title') || 'Project Demo';
        const description = target.getAttribute('data-description') || '';

        if (modalTitle) modalTitle.textContent = title;
        if (modalDescription) modalDescription.textContent = description;

        modal?.classList.remove('hidden');
      });
    });

    const closeModal = () => modal?.classList.add('hidden');
    closeModalBtn?.addEventListener('click', closeModal);
    modalDoneBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
  });
</script>