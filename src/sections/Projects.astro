---
const projects = [
  {
    id: "melomu",
    title: "Melomu",
    subtitle: "Offline Music App",
    description: "Melomu is an offline music player built with Expo and React Native. Import your own audio files, organize library, browse by song/album/artist, & build playlists — all backed by a local SQLite database, with synced lyrics cached for offline use.",
    tags: ["Expo", "React Native", "TypeScript", "SQLite", "Offline-first"],
    github: "https://github.com/darya-sajjad/Melomu",
    thumbnail: "/Melomu.png",
    demoTitle: "Melomu App Demo",
    demoMedia: [
      "/Melomu.mp4"
    ]
  },
  {
    id: "portfolio",
    title: "Developer Branding Platform",
    subtitle: "Personal portfolio, a mini project",
    description: "Challenging myself to step outside my native mobile comfort zone, I developed a personal branding platform to showcase my engineering ecosystem and transition from native mobile development into modern web architecture.",
    tags: ["Astro", "TypeScript", "Tailwind CSS", "Web development"],
    github: "https://github.com/darya-sajjad/Portfolio",
    thumbnail: "/Portfolio.png",
    demoTitle: "Portfolio Site Preview",
    demoMedia: [
      "/PorfolioDemo.png"
    ]
  },
];
---

<section id="projects" class="w-full max-w-7xl mx-auto py-6 sm:py-10">
  
  {/* Header Row: "My Projects" Pill + Pagination Controls */}
  <div class="flex items-center justify-between mb-5 sm:mb-6">
    
    <div class="bg-lavender border-2 border-black px-4 py-1.5 sm:px-5 sm:py-2 rounded-2xl shadow-[2.5px_2.5px_0px_0px_rgba(0,0,0,1)] -rotate-1">
      <h2 class="text-sm sm:text-base font-extrabold text-black uppercase tracking-wide">
        My Projects
      </h2>
    </div>

    <div class="flex items-center gap-2">
      <button 
        id="prev-grid-btn"
        aria-label="Previous Projects Grid"
        class="bg-white border-2 border-black w-8 h-8 sm:w-10 sm:h-10 rounded-xl flex items-center justify-center font-extrabold text-base sm:text-lg shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:bg-pink active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all disabled:opacity-30 disabled:cursor-not-allowed cursor-pointer"
      >
        &lt;
      </button>
      <button 
        id="next-grid-btn"
        aria-label="Next Projects Grid"
        class="bg-white border-2 border-black w-8 h-8 sm:w-10 sm:h-10 rounded-xl flex items-center justify-center font-extrabold text-base sm:text-lg shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:bg-pink active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all disabled:opacity-30 disabled:cursor-not-allowed cursor-pointer"
      >
        &gt;
      </button>
    </div>

  </div>

  {/* Projects Grid Container */}
  <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-5 min-h-[400px]">
    {projects.map((project) => (
      <div 
        class="project-card bg-white border-2 border-black rounded-2xl p-4 sm:p-5 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] flex flex-col justify-between hidden"
        data-id={project.id}
      >
        <div>
          {/* Card Thumbnail */}
          <div class="bg-pink border-2 border-black rounded-xl p-1.5 mb-3 shadow-[1.5px_1.5px_0px_0px_rgba(0,0,0,1)]">
            <div class="h-42 sm:h-42 bg-cream border border-black rounded-lg overflow-hidden flex items-center justify-center relative">
              <img 
                src={project.thumbnail} 
                alt={project.title}
                class="w-full h-full object-cover"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
              />
              <div class="w-full h-full flex flex-col items-center justify-center bg-gradient-to-br from-butter/40 to-pink/40 p-3 text-center hidden">
                <span class="text-xl mb-1">🖼️</span>
                <span class="text-[10px] font-bold text-black/60 uppercase">{project.title}</span>
              </div>
            </div>
          </div>

          <div class="mb-1.5">
            <h3 class="text-base sm:text-lg font-black text-black tracking-tight leading-snug">
              {project.title}
            </h3>
            <p class="text-[11px] sm:text-xs font-extrabold text-black/60">
              {project.subtitle}
            </p>
          </div>

          <p class="text-xs text-black/80 font-medium leading-relaxed mb-3">
            {project.description}
          </p>

          <div class="flex flex-wrap gap-1.5 mb-4">
            {project.tags.map(tag => (
              <span class="bg-cream border border-black px-2 py-0.5 rounded-md text-[10px] sm:text-[11px] font-bold shadow-[1px_1px_0px_0px_rgba(0,0,0,1)]">
                {tag}
              </span>
            ))}
          </div>
        </div>

        <div class="flex items-center gap-2 pt-3 border-t border-dashed border-black/20">
          <a 
            href={project.github}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 text-center bg-cream border-2 border-black py-1.5 rounded-xl text-xs font-extrabold text-black shadow-[1.5px_1.5px_0px_0px_rgba(0,0,0,1)] hover:bg-butter active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all"
          >
            GitHub Repo
          </a>

          <button
            type="button"
            class="open-demo-btn flex-1 text-center bg-sky border-2 border-black py-1.5 rounded-xl text-xs font-extrabold text-black shadow-[1.5px_1.5px_0px_0px_rgba(0,0,0,1)] hover:bg-matcha active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all cursor-pointer"
            data-title={project.demoTitle}
            data-media={JSON.stringify(project.demoMedia)}
          >
            View Demo &rarr;
          </button>
        </div>

      </div>
    ))}
  </div>

  <div id="grid-dots-container" class="flex justify-center items-center gap-2 mt-6"></div>

</section>

{/* --- MULTI-MEDIA DEMO POPUP MODAL --- */}
<div 
  id="demo-modal" 
  class="fixed inset-0 z-50 bg-black/65 backdrop-blur-xs flex items-center justify-center p-3 sm:p-4 hidden transition-opacity"
>
  <div class="bg-white border-2 sm:border-3 border-black rounded-3xl p-4 sm:p-6 max-w-2xl w-full shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] relative flex flex-col">
    
    {/* Modal Header */}
    <div class="flex items-center justify-between mb-3 border-b-2 border-black pb-2.5">
      <div>
        <span class="bg-pink border border-black px-2 py-0.5 rounded-full text-[9px] font-black uppercase tracking-wider mb-0.5 inline-block">
          Preview
        </span>
        <h3 id="modal-title" class="text-base sm:text-xl font-black text-black">
          Project Demo
        </h3>
      </div>
      
      <button 
        id="close-modal-btn"
        class="bg-cream border-2 border-black w-8 h-8 rounded-xl font-black text-base flex items-center justify-center hover:bg-pink shadow-[1.5px_1.5px_0px_0px_rgba(0,0,0,1)] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all cursor-pointer"
      >
        &times;
      </button>
    </div>

    {/* Media Viewer Frame (Flexible height with object-contain to preserve mobile proportions) */}
    <div class="bg-black/95 border-2 border-black rounded-2xl overflow-hidden mb-3 h-[380px] sm:h-[460px] flex items-center justify-center relative shadow-[inset_0px_2px_4px_rgba(0,0,0,0.5)]">
      
      {/* Active Media Slot */}
      <div id="modal-media-content" class="w-full h-full flex items-center justify-center p-2">
        {/* Dynamic Image or Video rendered via JS */}
      </div>

      {/* Carousel Prev Button */}
      <button 
        id="modal-prev-media"
        aria-label="Previous Media"
        class="absolute left-2 top-1/2 -translate-y-1/2 bg-white/90 border-2 border-black w-8 h-8 rounded-full font-black text-xs flex items-center justify-center shadow-[1.5px_1.5px_0px_0px_rgba(0,0,0,1)] hover:bg-pink active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all cursor-pointer hidden"
      >
        &lt;
      </button>

      {/* Carousel Next Button */}
      <button 
        id="modal-next-media"
        aria-label="Next Media"
        class="absolute right-2 top-1/2 -translate-y-1/2 bg-white/90 border-2 border-black w-8 h-8 rounded-full font-black text-xs flex items-center justify-center shadow-[1.5px_1.5px_0px_0px_rgba(0,0,0,1)] hover:bg-pink active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all cursor-pointer hidden"
      >
        &gt;
      </button>

      {/* Carousel Slide Counter Badge */}
      <div 
        id="modal-media-counter" 
        class="absolute bottom-2.5 right-2.5 bg-black/80 border border-white/30 text-white text-[10px] font-black px-2.5 py-0.5 rounded-lg backdrop-blur-xs hidden"
      >
        1 / 1
      </div>
    </div>

    {/* Modal Description */}
    <p id="modal-description" class="text-xs font-medium text-black/80 leading-relaxed mb-4">
      Project walkthrough description.
    </p>

  </div>
</div>

{/* Client Logic */}
<script>
  document.addEventListener('DOMContentLoaded', () => {
    let currentPage = 0;
    const cards = document.querySelectorAll<HTMLElement>('.project-card');
    const prevBtn = document.getElementById('prev-grid-btn') as HTMLButtonElement;
    const nextBtn = document.getElementById('next-grid-btn') as HTMLButtonElement;
    const dotsContainer = document.getElementById('grid-dots-container') as HTMLElement;

    function getItemsPerPage() {
      return window.innerWidth < 768 ? 2 : 4;
    }

    function updatePagination() {
      const itemsPerPage = getItemsPerPage();
      const totalPages = Math.ceil(cards.length / itemsPerPage);

      if (currentPage >= totalPages) {
        currentPage = Math.max(0, totalPages - 1);
      }

      const startIndex = currentPage * itemsPerPage;
      const endIndex = startIndex + itemsPerPage;

      cards.forEach((card, index) => {
        if (index >= startIndex && index < endIndex) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });

      if (dotsContainer) {
        dotsContainer.innerHTML = '';
        if (totalPages > 1) {
          for (let i = 0; i < totalPages; i++) {
            const dot = document.createElement('button');
            dot.className = `w-2.5 h-2.5 rounded-full border-2 border-black transition-all cursor-pointer ${
              i === currentPage ? 'bg-black w-5' : 'bg-white'
            }`;
            dot.setAttribute('aria-label', `Page ${i + 1}`);
            dot.addEventListener('click', () => {
              currentPage = i;
              updatePagination();
            });
            dotsContainer.appendChild(dot);
          }
        }
      }

      if (prevBtn) prevBtn.disabled = currentPage === 0 || totalPages <= 1;
      if (nextBtn) nextBtn.disabled = currentPage >= totalPages - 1 || totalPages <= 1;
    }

    if (prevBtn) prevBtn.addEventListener('click', () => {
      if (currentPage > 0) {
        currentPage--;
        updatePagination();
      }
    });

    if (nextBtn) nextBtn.addEventListener('click', () => {
      currentPage++;
      updatePagination();
    });

    window.addEventListener('resize', updatePagination);
    updatePagination();

    // --- Dynamic Modal Media Carousel Logic ---
    const modal = document.getElementById('demo-modal');
    const modalTitle = document.getElementById('modal-title');
    const modalDescription = document.getElementById('modal-description');
    const modalMediaContent = document.getElementById('modal-media-content');
    const modalPrevMedia = document.getElementById('modal-prev-media') as HTMLButtonElement;
    const modalNextMedia = document.getElementById('modal-next-media') as HTMLButtonElement;
    const modalMediaCounter = document.getElementById('modal-media-counter');
    
    const closeModalBtn = document.getElementById('close-modal-btn');
    const modalDoneBtn = document.getElementById('modal-done-btn');
    const openDemoBtns = document.querySelectorAll('.open-demo-btn');

    let activeMediaList: string[] = [];
    let activeMediaIndex = 0;

    function renderCurrentMedia() {
      if (!modalMediaContent || activeMediaList.length === 0) return;

      const mediaUrl = activeMediaList[activeMediaIndex];

      // Render video or image with object-contain to preserve full aspect ratio
      if (mediaUrl.endsWith('.mp4') || mediaUrl.endsWith('.webm')) {
        modalMediaContent.innerHTML = `
          <video src="${mediaUrl}" controls autoplay loop muted class="max-w-full max-h-full object-contain rounded-lg shadow-md"></video>
        `;
      } else {
        modalMediaContent.innerHTML = `
          <img src="${mediaUrl}" alt="Project preview slide" class="max-w-full max-h-full object-contain rounded-lg shadow-md" />
        `;
      }

      // Update Carousel Controls & Counter
      if (activeMediaList.length > 1) {
        modalPrevMedia?.classList.remove('hidden');
        modalNextMedia?.classList.remove('hidden');
        modalMediaCounter?.classList.remove('hidden');
        if (modalMediaCounter) {
          modalMediaCounter.textContent = `${activeMediaIndex + 1} / ${activeMediaList.length}`;
        }
      } else {
        modalPrevMedia?.classList.add('hidden');
        modalNextMedia?.classList.add('hidden');
        modalMediaCounter?.classList.add('hidden');
      }
    }

    openDemoBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const title = target.getAttribute('data-title') || 'Project Demo';
        const description = target.getAttribute('data-description') || '';
        const rawMedia = target.getAttribute('data-media') || '[]';

        try {
          activeMediaList = JSON.parse(rawMedia);
        } catch {
          activeMediaList = [];
        }

        activeMediaIndex = 0;

        if (modalTitle) modalTitle.textContent = title;
        if (modalDescription) modalDescription.textContent = description;

        renderCurrentMedia();
        modal?.classList.remove('hidden');
      });
    });

    // Media Navigation Buttons
    modalPrevMedia?.addEventListener('click', () => {
      if (activeMediaList.length > 1) {
        activeMediaIndex = (activeMediaIndex - 1 + activeMediaList.length) % activeMediaList.length;
        renderCurrentMedia();
      }
    });

    modalNextMedia?.addEventListener('click', () => {
      if (activeMediaList.length > 1) {
        activeMediaIndex = (activeMediaIndex + 1) % activeMediaList.length;
        renderCurrentMedia();
      }
    });

    const closeModal = () => {
      modal?.classList.add('hidden');
      if (modalMediaContent) modalMediaContent.innerHTML = '';
      activeMediaList = [];
      activeMediaIndex = 0;
    };

    closeModalBtn?.addEventListener('click', closeModal);
    modalDoneBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
  });
</script>