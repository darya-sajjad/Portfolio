---
---

<section id="contact" class="w-full max-w-7xl mx-auto py-8 sm:py-10">
  
  {/* Main Section Card with Distinct Background Color */}
  <div class="bg-lavender border-2 sm:border-3 border-black rounded-3xl p-6 sm:p-10 shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] relative overflow-hidden">
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-start">

      {/* --- LEFT COLUMN: HOOK & CONTACT / SOCIAL LINKS --- */}
      <div class="flex flex-col justify-between h-full">
        <div>
          {/* Section Tag */}
          <span class="bg-butter border-2 border-black px-3.5 py-1 rounded-full text-xs font-black uppercase tracking-wider shadow-[1.5px_1.5px_0px_0px_rgba(0,0,0,1)] inline-block mb-4 -rotate-1">
            Get In Touch
          </span>

          {/* Hook Heading */}
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-black leading-tight tracking-tight mb-4">
            Let's build something together.
          </h2>

          {/* Subheading */}
          <p class="text-sm sm:text-base font-medium text-black/85 leading-relaxed mb-8 max-w-md">
            I am currently open to remote engineering roles, freelance projects, and collaborations. Let's connect!
          </p>
        </div>

        {/* Direct Contact & Social Links Badges */}
        <div class="space-y-3 pt-2">
          <p class="text-xs font-black text-black uppercase tracking-wider mb-2">
            Direct Contact & Socials
          </p>

          <div class="flex flex-col sm:flex-row flex-wrap gap-2.5">
            {/* Email */}
            <a 
              href="mailto:example@gmail.com" 
              class="inline-flex items-center gap-2 bg-white border-2 border-black px-3.5 py-2 rounded-xl text-xs sm:text-sm font-extrabold text-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:bg-pink active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
              </svg>
              <span>gorahodarya@gmail.com</span>
            </a>

            {/* LinkedIn */}
            <a 
              href="https://www.linkedin.com/in/darya-s-6bb815330/" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-white border-2 border-black px-3.5 py-2 rounded-xl text-xs sm:text-sm font-extrabold text-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:bg-sky active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
              <span>LinkedIn</span>
            </a>

            {/* GitHub */}
            <a 
              href="https://github.com/darya-sajjad" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-white border-2 border-black px-3.5 py-2 rounded-xl text-xs sm:text-sm font-extrabold text-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:bg-matcha active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              <span>GitHub</span>
            </a>
          </div>
        </div>
      </div>

      {/* --- RIGHT COLUMN: FORMSPREE CONTACT FORM --- */}
      <div class="bg-white border-2 border-black rounded-2xl p-5 sm:p-7 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
        
        {/* IMPORTANT: Replace YOUR_FORMSPREE_ID with your real Formspree endpoint ID */}
        <form action="https://formspree.io/f/mwvgjjpe" method="POST" class="space-y-4">
          
          {/* Name Field */}
          <div>
            <label for="name" class="block text-xs font-black uppercase text-black mb-1.5">
              Your Name
            </label>
            <input 
              type="text" 
              id="name" 
              name="name" 
              required 
              placeholder="Daisy"
              class="w-full bg-cream border-2 border-black rounded-xl px-3.5 py-2.5 text-xs sm:text-sm font-medium text-black focus:bg-white focus:outline-none focus:ring-2 focus:ring-pink shadow-[1.5px_1.5px_0px_0px_rgba(0,0,0,1)] transition-all"
            />
          </div>

          {/* Email Field */}
          <div>
            <label for="email" class="block text-xs font-black uppercase text-black mb-1.5">
              Your Email
            </label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              required 
              placeholder="daisy@example.com"
              class="w-full bg-cream border-2 border-black rounded-xl px-3.5 py-2.5 text-xs sm:text-sm font-medium text-black focus:bg-white focus:outline-none focus:ring-2 focus:ring-pink shadow-[1.5px_1.5px_0px_0px_rgba(0,0,0,1)] transition-all"
            />
          </div>

          {/* Message Field */}
          <div>
            <label for="message" class="block text-xs font-black uppercase text-black mb-1.5">
              Message
            </label>
            <textarea 
              id="message" 
              name="message" 
              rows="4" 
              required 
              placeholder="Hi Darya, let's talk about building..."
              class="w-full bg-cream border-2 border-black rounded-xl px-3.5 py-2.5 text-xs sm:text-sm font-medium text-black focus:bg-white focus:outline-none focus:ring-2 focus:ring-pink shadow-[1.5px_1.5px_0px_0px_rgba(0,0,0,1)] transition-all resize-none"
            ></textarea>
          </div>

          {/* Send Button */}
          <button 
            type="submit" 
            class="w-full bg-pink border-2 border-black py-3 rounded-xl text-xs sm:text-sm font-black text-black uppercase tracking-wider shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] hover:bg-butter active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all cursor-pointer flex items-center justify-center gap-2"
          >
            <span>Send Message</span>
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
            </svg>
          </button>

        </form>
      </div>

    </div>

    {/* --- BOTTOM ROW: COPYRIGHT & TECH STACK (Spans full width across columns) --- */}
    <div class="mt-10 sm:mt-12 pt-6 border-t-2 border-black flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left">
      <div>
        <p class="text-xs sm:text-sm font-extrabold text-black">
          &copy; {new Date().getFullYear()} Darya Sajjad. All rights reserved.
        </p>
      </div>

      <div>
        <span class="inline-flex items-center gap-1.5 bg-white border border-black px-3 py-1 rounded-lg text-[11px] font-bold shadow-[1px_1px_0px_0px_rgba(0,0,0,1)]">
          Built with <span class="text-pink">♥</span> using Astro, Tailwind CSS & Vercel
        </span>
      </div>
    </div>

  </div>
</section>