---
import MacWindow from './MacWindow.jsx';
---

<section id="contact" class="my-12">
  <MacWindow title="Contact_Dialog.sys" client:visible>
    <div class="text-center space-y-4 font-pixelify py-4">
      <h2 class="font-pixeboy text-3xl uppercase tracking-wide">
        LET'S CONNECT[cite: 1]
      </h2>
      
      <p class="text-sm text-gray-800 max-w-md mx-auto">
        Currently open for React / React Native developer roles[cite: 1]. Feel free to send an email or check out my work across the web![cite: 1]
      </p>

      <div class="flex justify-center flex-wrap gap-4 pt-4">
        <a 
          href="mailto:your.email@example.com" 
          class="border-2 border-black bg-[var(--color-mac-yellow)] px-5 py-2 text-xs font-bold shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] hover:bg-black hover:text-white transition-colors"
        >
          ✉ EMAIL ME[cite: 1]
        </a>
        <a 
          href="https://github.com/yourusername" 
          target="_blank" 
          rel="noopener noreferrer"
          class="border-2 border-black bg-white px-5 py-2 text-xs font-bold shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] hover:bg-black hover:text-white transition-colors"
        >
          GITHUB[cite: 1]
        </a>
        <a 
          href="https://linkedin.com/in/yourusername" 
          target="_blank" 
          rel="noopener noreferrer"
          class="border-2 border-black bg-white px-5 py-2 text-xs font-bold shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] hover:bg-black hover:text-white transition-colors"
        >
          LINKEDIN[cite: 1]
        </a>
      </div>
    </div>
  </MacWindow>
</section>