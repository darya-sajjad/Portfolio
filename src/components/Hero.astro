---
import MacWindow from './MacWindow.jsx';
---

<section class="my-6 text-center">
  <!-- Top decorative badge -->
  <div class="mb-4 flex justify-center items-center gap-2">
    <span class="font-pixelify text-xs font-bold tracking-widest uppercase bg-white border border-black px-2 py-0.5 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
      Portfolio v1.0
    </span>
  </div>

  <!-- Giant Retro Headline -->
  <h1 class="font-pixeboy text-5xl sm:text-7xl uppercase tracking-wider mb-6 text-balance leading-none">
    Darya Sajjad
  </h1>

  <!-- System Notice Window -->
  <MacWindow title="Welcome.exe" client:load className="max-w-2xl mx-auto text-left">
    <div class="space-y-4">
      <p class="font-pixelify text-base sm:text-lg leading-relaxed">
        Building cross-platform apps with <mark class="bg-[var(--color-mac-yellow)] px-1 font-bold">React</mark>, 
        <mark class="bg-[var(--color-mac-yellow)] px-1 font-bold">React Native</mark>, and <mark class="bg-[var(--color-mac-yellow)] px-1 font-bold">Expo</mark>.
      </p>
      
      <p class="text-xs sm:text-sm text-gray-700 font-mono">
        Final-semester Software Engineering student focusing on clean architecture, mobile usability, and thoughtful design[cite: 1].
      </p>

      <div class="pt-2 flex flex-wrap gap-3">
        <a 
          href="#projects" 
          class="border-2 border-black bg-white px-4 py-2 font-pixelify text-xs font-bold shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:bg-black hover:text-white transition-colors flex items-center gap-2"
        >
          <span>VIEW PROJECTS</span>
        </a>
        <a 
          href="#contact" 
          class="border-2 border-black bg-[var(--color-mac-yellow)] px-4 py-2 font-pixelify text-xs font-bold shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:bg-black hover:text-white transition-colors flex items-center gap-2"
        >
          <span>CONTACT / RESUME</span>
        </a>
      </div>
    </div>
  </MacWindow>
</section>