---
const categories = [
  {
    title: "Frontend",
    skills: ["React", "HTML5", "CSS3", "Tailwind CSS", "NativeWind"]
  },
  {
    title: "Mobile & Desktop",
    skills: ["Expo", "React Native", "Electron"]
  },
  {
    title: "Backend & DB",
    skills: ["Node.js", "SQLite", "Supabase"]
  },
  {
    title: "Tools & Deployment",
    skills: ["Git", "Vercel", "Testing Tools"]
  }
];
---

<section id="skills" class="my-12">
  <div class="border-2 border-black bg-white p-6 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
    <h2 class="font-pixeboy text-3xl uppercase tracking-wide mb-6 border-b-2 border-black pb-2">
      TECH STACK & TOOLS[cite: 1]
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {categories.map((cat) => (
        <div class="border border-black p-4 bg-[var(--color-mac-card)] shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
          <h3 class="font-pixelify font-bold text-xs uppercase mb-3 text-gray-700 tracking-wider">
            [{cat.title}]
          </h3>
          <div class="flex flex-wrap gap-2">
            {cat.skills.map((skill) => (
              <span class="bg-[var(--color-mac-dark)] text-white text-xs font-mono px-3 py-1 rounded-full shadow-sm hover:bg-gray-800 transition-colors">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>