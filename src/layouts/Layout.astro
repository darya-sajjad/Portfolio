---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Darya's Portfolio" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-cream min-h-screen font-sans text-black selection:bg-pink selection:text-black">
		
		{/* --- NAVBAR START --- */}
		<header class="fixed top-5 left-0 w-full z-50 px-4 sm:px-6 flex justify-center">
		  <nav class="bg-white border-2 border-black rounded-full px-4 sm:px-6 py-2.5 flex items-center justify-between w-full max-w-3xl shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] transition-all">
		    
		    {/* Left: Brand / Logo */}
		    <a 
		      href="/" 
		      class="text-base sm:text-lg font-extrabold tracking-tight text-black hover:text-pink transition-colors"
		    >
		      Darya
		    </a>

		    {/* Center: Navigation Links */}
		    <ul class="flex items-center gap-1 sm:gap-3 text-xs sm:text-sm font-semibold text-black">
		      <li>
		        <a href="/" class="px-2.5 py-1 rounded-full hover:bg-butter transition-colors">Home</a>
		      </li>
		      <li class="text-black/30 select-none font-bold">&middot;</li>
		      <li>
		        <a href="#about" class="px-2.5 py-1 rounded-full hover:bg-sky transition-colors">About</a>
		      </li>
		      <li class="text-black/30 select-none font-bold">&middot;</li>
		      <li>
		        <a href="#projects" class="px-2.5 py-1 rounded-full hover:bg-matcha transition-colors">Projects</a>
		      </li>
		      <li class="text-black/30 select-none font-bold">&middot;</li>
		      <li>
		        <a href="#contact" class="px-2.5 py-1 rounded-full hover:bg-lavender transition-colors">Contact</a>
		      </li>
		    </ul>

		    {/* Right: Social Icon Links */}
		    <div class="flex items-center gap-2">
		      {/* LinkedIn */}
		      <a 
		        href="YOUR_LINKEDIN_URL" 
		        target="_blank" 
		        rel="noopener noreferrer" 
		        aria-label="LinkedIn" 
		        class="flex items-center justify-center w-8 h-8 border-2 border-black rounded-xl bg-white hover:bg-sky active:translate-x-[1px] active:translate-y-[1px] transition-all shadow-[1.5px_1.5px_0px_0px_rgba(0,0,0,1)]"
		      >
		        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
		          <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
		        </svg>
		      </a>
		      
		      {/* GitHub */}
		      <a 
		        href="https://github.com/darya-sajjad" 
		        target="_blank" 
		        rel="noopener noreferrer" 
		        aria-label="GitHub" 
		        class="flex items-center justify-center w-8 h-8 border-2 border-black rounded-xl bg-white hover:bg-tangerine active:translate-x-[1px] active:translate-y-[1px] transition-all shadow-[1.5px_1.5px_0px_0px_rgba(0,0,0,1)]"
		      >
		        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
		          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
		        </svg>
		      </a>
		    </div>

		  </nav>
		</header>
		{/* --- NAVBAR END --- */}

		{/* Page Content Slot - Expanded to max-w-7xl with wider side padding */}
		<main class="pt-28 pb-16 px-4 sm:px-8 md:px-12 max-w-7xl mx-auto flex flex-col items-center w-full">
			<slot />
		</main>

	</body>
</html>