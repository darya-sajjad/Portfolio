---
// src/layouts/Layout.astro
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-[var(--color-mac-bg)] min-h-screen text-[#121212] font-pixelify selection:bg-[#ffe36d]">
    <!-- Top System 7 Menu Bar -->
    <header class="border-b-2 border-black bg-white px-4 py-1.5 text-xs font-pixelify font-bold flex justify-between items-center sticky top-0 z-50 shadow-sm">
      <div class="flex items-center gap-4">
        <span class="text-sm"></span>
        <span class="hidden sm:inline">React & React Native Developer</span>
      </div>
      <nav class="flex gap-4 sm:gap-6">
        <a href="#about" class="hover:underline">About</a>
        <a href="#skills" class="hover:underline">Skills</a>
        <a href="#projects" class="hover:underline">Projects</a>
        <a href="#contact" class="hover:underline">Contact</a>
      </nav>
    </header>

    <main class="max-w-4xl mx-auto px-4 py-8">
      <slot />
    </main>
  </body>
</html>