---
import '../styles/global.css';
interface Props {
  title?: string;
}

const { title = "Darya Sajjad | Full-Stack App Developer" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="Portfolio showcasing offline mobile apps, modern web apps, and desktop tools." />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://portfolio-chi-woad-95.vercel.app/" />
    <meta property="og:title" content="Darya Sajjad | Full-Stack App Developer" />
    <meta property="og:description" content="Portfolio showcasing offline mobile apps, modern web apps, and desktop tools." />
    <meta property="og:image" content="https://portfolio-chi-woad-95.vercel.app/Cover.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Darya Sajjad | Full-Stack App Developer" />
    <meta name="twitter:description" content="Portfolio showcasing offline mobile apps, modern web apps, and desktop tools." />
    <meta name="twitter:image" content="https://portfolio-chi-woad-95.vercel.app/Cover.png" />
  </head>
  <body class="bg-cream text-black font-sans min-h-screen">
    <slot />
  </body>
</html>