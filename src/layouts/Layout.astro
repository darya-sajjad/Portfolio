---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Darya's Portfolio" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://portfolio-chi-woad-95.vercel.app/" />
		<meta property="og:title" content="Darya Sajjad | Full-Stack App Developer" />
		<meta property="og:description" content="Portfolio showcasing offline mobile apps, modern web apps, and desktop tools." />
		<meta property="og:image" content="https://portfolio-chi-woad-95.vercel.app/Cover.png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Darya Sajjad | Full-Stack App Developer" />
		<meta name="twitter:description" content="Portfolio showcasing offline mobile apps, modern web apps, and desktop tools." />
		<meta name="twitter:image" content="https://portfolio-chi-woad-95.vercel.app/Cover.png" />
	</head>

	<body class="bg-cream min-h-screen font-sans text-black selection:bg-pink selection:text-black">
		
		<header class="fixed top-5 left-0 w-full z-50 px-4 sm:px-6 flex justify-center">
		  <nav class="w-full max-w-5xl mx-auto px-4 py-4">
			<div class="bg-white border-2 sm:border-3 border-black rounded-4xl px-4 sm:px-6 py-2.5 sm:py-3 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] flex items-center justify-between gap-2">

				<a href="#" class="font-black text-sm sm:text-base text-black tracking-wide shrink-0">
				Darya
				</a>

				<div class="flex items-center gap-3 sm:gap-6">
				<a href="#about" class="text-xs sm:text-sm font-bold text-black hover:underline">
					About
				</a>
				<a href="#projects" class="text-xs sm:text-sm font-bold text-black hover:underline">
					Projects
				</a>
				<a href="#contact" class="text-xs sm:text-sm font-bold text-black hover:underline">
					Contact
				</a>
				</div>

				<div class="hidden sm:flex items-center gap-3 shrink-0">
				<a 
					href="https://github.com/darya-sajjad" 
					target="_blank" 
					rel="noopener noreferrer" 
					aria-label="GitHub Profile"
					class="p-2 border-2 border-black rounded-xl bg-cream hover:bg-pink transition-colors flex items-center justify-center shrink-0"
				>
					<svg class="w-4 h-4 fill-current text-black" viewBox="0 0 24 24">
					<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
					</svg>
				</a>

				<a 
					href="https://www.linkedin.com/in/darya-s-6bb815330/" 
					target="_blank" 
					rel="noopener noreferrer" 
					aria-label="LinkedIn Profile"
					class="p-2 border-2 border-black rounded-xl bg-cream hover:bg-pink transition-colors flex items-center justify-center shrink-0"
				>
					<svg class="w-4 h-4 fill-current text-black" viewBox="0 0 24 24">
					<path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
					</svg>
				</a>
				</div>

			</div>
			</nav>
		</header>

		<main class="pt-28 pb-16 px-4 sm:px-8 md:px-12 max-w-7xl mx-auto flex flex-col items-center w-full">
			<slot />
		</main>
	</body>
</html>